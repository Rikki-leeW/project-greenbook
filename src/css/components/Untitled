/* =======================================
   GARDEN OF MINE
   SHARED PAGE LAYOUT

   This file owns the common geometry of
   destination pages.

   Individual page styles may add their
   own content presentation, but should
   not recreate the page shell,
   navigation, header or Back to top.
======================================= */


/* =======================================
   PAGE SHELL
======================================= */

.garden-page,
.journal-page,
.plant-story-page {
  width:
    min(
      100%,
      1180px
    );

  min-height:
    100vh;

  margin:
    0 auto;

  padding:
    42px
    28px
    124px;
}


/*
 * Compatibility while older pages are
 * migrated to the shared GardenPage
 * component.
 */

.plant-story-page,
.garden-page--narrow {
  width:
    min(
      100%,
      960px
    );

  padding-top:
    38px;
}


/* =======================================
   PAGE NAVIGATION

   Back remembers the journey.
   Home remembers where the record lives.
======================================= */

.garden-page-navigation {
  display:
    flex;

  flex-wrap:
    wrap;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    10px
    18px;

  width:
    100%;

  margin:
    0
    0
    22px;
}


.garden-page-navigation-links,
.garden-page-navigation-actions {
  display:
    flex;

  flex-wrap:
    wrap;

  align-items:
    center;

  gap:
    8px;
}


.garden-page-navigation-button {
  appearance:
    none;

  -webkit-appearance:
    none;

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  width:
    auto;

  max-width:
    100%;

  min-height:
    40px;

  margin:
    0;

  padding:
    9px
    14px;

  border:
    1px solid
    rgba(
      73,
      91,
      66,
      0.16
    );

  border-radius:
    11px;

  background:
    rgba(
      255,
      250,
      240,
      0.68
    );

  color:
    #52694d;

  font:
    inherit;

  font-size:
    0.82rem;

  font-weight:
    700;

  line-height:
    1.25;

  text-align:
    center;

  white-space:
    normal;

  cursor:
    pointer;

  box-shadow:
    0 4px 11px
    rgba(
      52,
      70,
      48,
      0.06
    );

  transition:
    transform
      150ms ease,
    background
      150ms ease,
    border-color
      150ms ease,
    box-shadow
      150ms ease;
}


.garden-page-navigation-button:hover {
  transform:
    translateY(-1px);

  border-color:
    rgba(
      73,
      91,
      66,
      0.30
    );

  background:
    rgba(
      255,
      253,
      247,
      0.96
    );

  box-shadow:
    0 7px 16px
    rgba(
      52,
      70,
      48,
      0.09
    );
}


.garden-page-navigation-button:active {
  transform:
    translateY(0);
}


.garden-page-navigation-button:focus-visible {
  outline:
    3px solid
    rgba(
      82,
      112,
      71,
      0.18
    );

  outline-offset:
    3px;
}


/* =======================================
   PAGE HEADER
======================================= */

.garden-header,
.journal-header {
  display:
    flex;

  align-items:
    flex-start;

  justify-content:
    space-between;

  gap:
    28px;

  margin-bottom:
    34px;
}


.garden-header-copy {
  flex:
    1 1 auto;

  min-width:
    0;
}


.garden-title {
  max-width:
    720px;

  margin-top:
    8px;

  font-size:
    clamp(
      2.1rem,
      6vw,
      4rem
    );

  line-height:
    1.05;
}


.garden-subtitle,
.journal-intro {
  max-width:
    660px;

  margin:
    14px
    0
    0;

  color:
    var(--ink-soft);

  font-size:
    1.08rem;

  line-height:
    1.7;
}


.garden-page-header-actions {
  display:
    flex;

  flex:
    0 0 auto;

  flex-wrap:
    wrap;

  align-items:
    center;

  justify-content:
    flex-end;

  gap:
    10px;

  min-width:
    0;

  padding-top:
    4px;
}


/* =======================================
   SHARED SECTION HEADINGS
======================================= */

.section-label {
  margin:
    0
    0
    5px;

  color:
    #7a896f;

  font-size:
    0.75rem;

  font-weight:
    800;

  letter-spacing:
    0.15em;

  text-transform:
    uppercase;
}


.section-heading {
  display:
    flex;

  align-items:
    end;

  justify-content:
    space-between;

  gap:
    20px;

  margin-bottom:
    18px;
}


.section-heading h2,
.keeper-card h2 {
  margin:
    0;

  color:
    var(--ink);

  font-size:
    1.65rem;
}


/* =======================================
   QUIET TEXT ACTION
======================================= */

.text-button {
  border:
    0;

  background:
    transparent;

  color:
    var(--moss);

  font-weight:
    800;

  cursor:
    pointer;
}


/* =======================================
   BACK TO TOP
======================================= */

.garden-back-to-top {
  display:
    flex;

  justify-content:
    center;

  width:
    100%;

  margin:
    28px
    0
    30px;
}


.garden-back-to-top
.text-button {
  margin:
    0;

  padding:
    9px
    12px;
}


/* =======================================
   TABLET / PHONE
======================================= */

@media (max-width: 760px) {

  .garden-page,
  .journal-page,
  .plant-story-page {
    padding:
      28px
      16px
      112px;
  }


  .garden-page-navigation {
    align-items:
      flex-start;

    margin-bottom:
      18px;
  }


  .garden-header,
  .journal-header {
    display:
      grid;

    gap:
      18px;
  }


  .garden-page-header-actions {
    justify-content:
      flex-start;

    padding-top:
      0;
  }
}


/* =======================================
   SMALL PHONE
======================================= */

@media (max-width: 480px) {

  .garden-page-navigation {
    display:
      grid;

    gap:
      8px;
  }


  .garden-page-navigation-links,
  .garden-page-navigation-actions {
    width:
      100%;
  }


  .garden-page-navigation-button {
    justify-content:
      flex-start;

    text-align:
      left;
  }


  .garden-page-header-actions {
    width:
      100%;
  }
}